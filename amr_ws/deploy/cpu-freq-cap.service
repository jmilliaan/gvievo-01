[Unit]
Description=Turbo on, capped at 3.0 GHz (gvievo-ce: i3-N300 IPC with active fan, 24 h duty)
# Replaces cpu-no-turbo.service. Uncapped turbo (3.6 GHz, PL2 25 W) drove the package to
# 100 C and throttled it 86 times in 2 h (2026-10-02) on the fanless N97 unit, capped 2.2 GHz there.
# gvievo-ce (2026-11-23): the kyb unit is an i3-N300 (8 cores, max 3.8 GHz) with an active fan,
# so the ceiling is raised to 3.0 GHz. Verify under load: package_throttle_count stays 0.
Before=amr.service
Conflicts=cpu-no-turbo.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Order matters: toggling no_turbo resets every policy's scaling_max_freq to the new
# ceiling, so the cap is written after it. 3000000 kHz = ratio 30, an exact P-state.
ExecStart=/bin/sh -c 'echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo; for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do echo 3000000 > "$f"; done'
# Back to base clock with turbo off when the unit stops.
ExecStop=/bin/sh -c 'echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo'

[Install]
WantedBy=multi-user.target
