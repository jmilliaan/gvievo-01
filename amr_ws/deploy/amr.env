# Environment for the amr_nav / amr_mapping units (EnvironmentFile=).
# Edit, then `sudo systemctl restart amr_nav`. Restarting never starts a route:
# the executor comes up IDLE and needs a mission loaded, localisation READY,
# the selector in AUTO and a physical Start edge.
AMR_MAP_ID=line_section
AMR_MAP_REVISION=latest
AMR_MAPS_DIR=/home/gvipc-evo-01/amr_maps
AMR_FOXGLOVE=true
